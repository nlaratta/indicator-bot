# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# Safe by default: 1 = log signals only, place no orders, need no credentials.
# Set to 0 only when you are sure; then all three credentials below are required.
DRY_RUN=1

KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Optional overrides (defaults shown)
# FEE=0.001
# FUNDS=10
# SYMBOL=BTC-USDT
# PERIOD=5min
# POLL_SECONDS=1
